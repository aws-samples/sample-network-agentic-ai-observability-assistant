# ==============================================================================
# Network Observability Agent - environment configuration
#
# Copy this file to .env and set the values for your environment:
#   cp .env.example .env
#
# .env is gitignored; never commit real values.
# ==============================================================================

# --- Required ---

# AWS region used for all boto3 clients and Bedrock calls.
AWS_REGION=us-east-1

# Bedrock model (inference profile ID) the agents use for reasoning.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# CloudWatch Logs group that receives your VPC Flow Logs.
VPC_FLOW_LOG_GROUP=/aws/vpc/flowlogs/your-vpc-name

# --- Optional ---

# AWS Network Firewall log groups. Set both to enable the firewall agent;
# leave commented out if you don't use Network Firewall.
# FIREWALL_ALERT_LOG_GROUP=/aws/network-firewall/alert/your-firewall
# FIREWALL_FLOW_LOG_GROUP=/aws/network-firewall/flow/your-firewall

# Bedrock Knowledge Base ID. Set to enable the knowledge base agent;
# the solution works without it.
# KNOWLEDGE_BASE_ID=your-kb-id
